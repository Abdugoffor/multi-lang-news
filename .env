# Go HTTP server and PostgreSQL driver.
DB_DRIVER=postgres

APP_PORT=8082
# Go -> PgBouncer (not the PostgreSQL backend port).
DB_HOST=127.0.0.1
DB_PORT=6432
# Shared PostgreSQL and PgBouncer login/password.
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=golang
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Tashkent

JWT_KEY=jwt_key

AUTH_GRPC_PORT=50051
MARKET_GRPC_PORT=50052
ORDER_GRPC_PORT=50053
PAYMENT_GRPC_PORT=50054
CURYER_GRPC_PORT=50055

https://chatgpt.com/c/6a25c73a-1a90-83ed-a4de-1c082cf5c787
# pgAdmin (local Docker)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
# PgBouncer container -> PostgreSQL installed on this computer.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
# PgBouncer admin database: pgbouncer; credentials: DB_USER / DB_PASSWORD.
PGBOUNCER_PORT=6432
PGBOUNCER_ADMIN_USERS=postgres
# Go -> Redis; host port 6380 maps to container port 6379.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=5ed4f19fb53e17a9fa584b84531f02c99e54161b9ed0db48b0c9c0ecdc30d46b
REDIS_DB=0
