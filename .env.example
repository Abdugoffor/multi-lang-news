# Local example. Match DB_USER / DB_PASSWORD to your installed PostgreSQL.
APP_PORT=8082
DB_DRIVER=postgres

# Go -> PgBouncer.
DB_HOST=127.0.0.1
DB_PORT=6432
# Shared PostgreSQL and PgBouncer login/password (current local setup).
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=golang
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Tashkent

# PgBouncer container -> PostgreSQL installed on the Docker host.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Admin database: pgbouncer; credentials: DB_USER / DB_PASSWORD.
PGBOUNCER_PORT=6432
PGBOUNCER_ADMIN_USERS=postgres

# Go -> Redis. Replace this example Redis password before copying to .env.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=replace-with-a-random-password
REDIS_DB=0
